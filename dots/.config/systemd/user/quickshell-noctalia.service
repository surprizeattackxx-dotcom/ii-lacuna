[Unit]
Description=Quickshell (noctalia config)
Documentation=https://quickshell.outfoxxed.me
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c noctalia-shell
Restart=always
RestartSec=1
# Raise file-descriptor limit — the wallpaper picker spawns many concurrent
# thumbnail (magick) processes plus execDetached calls; the default 1024 soft
# cap gets exhausted and blocks new processes (DDG search, AI pick, etc.)
LimitNOFILE=524288
Slice=session.slice
# The claude-code-panel plugin spawns a claude-code-acp (node) child that
# ignores SIGTERM, so a restart otherwise waits the full 10s default stop
# timeout before SIGKILL. Cap it low and kill the whole cgroup so reloads
# don't hang ~10s draining that orphaned node process.
TimeoutStopSec=2s
KillMode=mixed

[Install]
WantedBy=graphical-session.target

[Unit]
Description=Auto commit+push ~/.config/noctalia on change
# Wait for network so the initial catch-up push can reach GitHub.
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.config/noctalia/scripts/autopush.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

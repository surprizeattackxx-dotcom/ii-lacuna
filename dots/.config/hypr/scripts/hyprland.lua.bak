-- Content from hyprland/colors.lua
-- Hyprland Colors
-- Replaces hyprland/colors.conf
--
hl.config({
    general = {
        col = {
            active_border = "rgba(7c776c77)",
            inactive_border = "rgba(ccc6ba55)",
        },
    },
    misc = {
        background_color = "rgba(141311FF)",
    },
})
-- Hyprbars plugin config
hl.config({
    plugin = {
        hyprbars = {
            bar_text_font = "Google Sans Flex Medium, Rubik, Geist, AR One Sans, Reddit Sans, Inter, Roboto, Ubuntu, Noto Sans, sans-serif",
            bar_height = 30,
            bar_padding = 10,
            bar_button_padding = 5,
            bar_precedence_over_border = true,
            bar_part_of_window = true,
            bar_color = "rgba(fef8f5FF)",
            col = {
                text = "rgba(1d1b19FF)",
            },
            buttons = {
                { color = "rgb(1d1b19)", size = 13, icon = "󰖭", on_click = "hyprctl dispatch killactive" },
                { color = "rgb(1d1b19)", size = 13, icon = "󰖯", on_click = "hyprctl dispatch fullscreen 1" },
                { color = "rgb(1d1b19)", size = 13, icon = "󰖰", on_click = "hyprctl dispatch movetoworkspacesilent special" },
            },
        },
    },
})
-- Window rule for pinned windows border color
hl.window_rule({
    match = { pin = true },
    border_color = { "rgba(665e48AA)", "rgba(665e4877)" },
})

-- Content from hyprland/env.lua
-- Hyprland Environment Variables
-- Replaces hyprland/env.conf
--
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")
-- Applications
hl.env("XDG_DATA_DIRS", os.getenv("HOME") .. "/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share")
-- Themes
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("QT_QPA_PLATFORMTHEME", "kde")
hl.env("XDG_MENU_PREFIX", "plasma-")
-- Virtual environment
hl.env("ILLOGICAL_IMPULSE_VIRTUAL_ENV", os.getenv("HOME") .. "/.local/state/quickshell/.venv")
-- Terminal application
hl.env("TERMINAL", "kitty -1")
hl.env("EDITOR", "kate")

-- Content from hyprland/execs.lua
-- Hyprland Autostart
-- Replaces hyprland/execs.conf
--
hl.on("hyprland.start", function()
    hl.exec_cmd(os.getenv("HOME") .. "/.config/hypr/hyprland/scripts/start_geoclue_agent.sh")
    hl.exec_cmd("qs -c " .. _G.qsConfig .. " &")
    hl.exec_cmd(os.getenv("HOME") .. "/.config/hypr/custom/scripts/__restore_video_wallpaper.sh")
    hl.exec_cmd("sleep 3 && bash " .. os.getenv("HOME") .. "/.config/quickshell/ii/scripts/colors/switchwall.sh --restore")
    -- Core components (authentication, lock screen, notification daemon)
    hl.exec_cmd("gnome-keyring-daemon --start --components=secrets")
    -- hl.exec_cmd("hypridle")
    hl.exec_cmd("dbus-update-activation-environment --all")
    hl.exec_cmd("sleep 1 && dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    -- Audio
    hl.exec_cmd("easyeffects --hide-window --service-mode")
    -- Clipboard: history
    hl.exec_cmd("wl-paste --type text --watch bash -c 'cliphist store && qs -c " .. _G.qsConfig .. " ipc call cliphistService update'")
    hl.exec_cmd("wl-paste --type image --watch bash -c 'cliphist store && qs -c " .. _G.qsConfig .. " ipc call cliphistService update'")
end)


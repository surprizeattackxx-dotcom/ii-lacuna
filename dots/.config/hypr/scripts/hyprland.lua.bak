    local code = { 87, 88, 89, 83, 84, 85, 79, 80, 81, 90 }
    hl.bind(mainMod .. " + ALT + code:" .. code[i], hl.dsp.exec_cmd(os.getenv("HOME") .. "/.config/hypr/hyprland/scripts/workspace_action.sh movetoworkspacesilent " .. i))
end
-- Workspace movement

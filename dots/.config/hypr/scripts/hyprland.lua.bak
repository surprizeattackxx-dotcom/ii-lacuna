    hl.bind(mainMod .. " + ALT + code:" .. (10 + i), hl.dsp.exec_cmd(os.getenv("HOME") .. "/.config/hypr/hyprland/scripts/workspace_action.sh movetoworkspacesilent " .. i))
end

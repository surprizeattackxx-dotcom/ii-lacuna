hl.bind(mainMod .. " + code:86", hl.dsp.exec_cmd("qs -c " .. _G.qsConfig .. " ipc call zoom zoomIn"), { repeating = true })
hl.bind(mainMod .. " + code:82", hl.dsp.exec_cmd("qs -c " .. _G.qsConfig .. " ipc call TEST_ALIVE || " .. os.getenv("HOME") .. "/.config/hypr/hyprland/scripts/zoom.sh decrease 0.1"), { repeating = true })
hl.bind(mainMod .. " + code:86", hl.dsp.exec_cmd("qs -c " .. _G.qsConfig .. " ipc call TEST_ALIVE || " .. os.getenv("HOME") .. "/.config/hypr/hyprland/scripts/zoom.sh increase 0.1"), { repeating = true })

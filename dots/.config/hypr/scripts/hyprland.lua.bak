-- Content from custom/env.lua
-- Custom Environment Variables
-- Replaces custom/env.conf
--
-- Driver
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
hl.env("AQ_DRM_DEVICES", ",/dev/dri/card1:/dev/dri/card0")
hl.env("GDK_BACKEND", "wayland,x11,*")
hl.env("SDL_VIDEODRIVER", "wayland")
hl.env("CLUTTER_BACKEND", "wayland")
-- XDG
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
-- Nvidia
hl.env("GBM_BACKEND", "nvidia-drm")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GL_GSYNC_ALLOWED", "")
hl.env("__GL_VRR_ALLOWED", "")
-- Themes
hl.env("XCURSOR_THEME", "oreo_gruvbox_grey_cursors")
hl.env("XCURSOR_SIZE", "24")
hl.env("XDG_ICON_THEME", "Papirus-Light")
-- Defaults
_G.editor = "kate"

-- Content from custom/execs.lua
-- Custom Autostart
-- Replaces custom/execs.conf
--
hl.on("hyprland.start", function()
    -- Apps
    hl.exec_cmd("discord")
    hl.exec_cmd("steam")
    hl.exec_cmd("hamr")
    hl.exec_cmd("hyprpm reload")
    hl.exec_cmd("thunderbird")
    hl.exec_cmd("openrgb --gui --start-minimized --profile \"Default\"")
    -- Cursor theme
    hl.exec_cmd("hyprctl setcursor oreo_gruvbox_grey_cursors 24")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface cursor-theme oreo_gruvbox_grey_cursors")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface cursor-size 24")
    hl.exec_cmd("mkdir -p " .. os.getenv("HOME") .. "/.icons/default && printf '[Icon Theme]\nInherits=oreo_gruvbox_grey_cursors\n' > " .. os.getenv("HOME") .. "/.icons/default/index.theme")
end)


-- Content from custom/rules.lua
-- Custom Window and Layer Rules
-- Replaces custom/rules.conf
--
-- Terminal Effects
hl.window_rule({ match = { class = "^(kitty)$" }, opacity = 0.95, no_blur = false, xray = true })
-- Additional Utilities to float
hl.window_rule({ 
    match = { class = "^(blueman-manager|polkit-gnome-authentication-agent-1|org.gnome.polkit|lxpolkit)$" }, 
    float = true, 
    center = true, 
    no_blur = false 
})
hl.window_rule({ match = { class = "^(blueman-manager)$" }, size = { 800, 500 } })
-- Media & Graphics Workspaces
hl.window_rule({ match = { class = "^(Spotify)$" }, workspace = 8 })
hl.window_rule({ match = { class = "^(Gimp-2.10)$" }, workspace = 9 })
-- Media Players (Float & Center)
hl.window_rule({ match = { class = "^(mpv|imv|vlc)$" }, float = true, center = true })
-- Steam sub-windows
hl.window_rule({ 
    match = { class = "^(steam)$", title = "^(Friends List|Steam - News|Settings|Steam Settings|.* - Chat|.* - Shop)$" }, 
    float = true, 
    center = true 
})
-- Theme Utilities & System Tools
hl.window_rule({ 
    match = { class = "^(nwg-look|qt5ct|qt6ct|kvantummanager)$" }, 
    float = true, 
    center = true 
})
hl.window_rule({ match = { class = "^(qalculate-gtk)$" }, float = true, center = true })
-- Center all floating windows by default
hl.window_rule({ match = { float = true }, center = true })
-- Quickshell Layer Rules
hl.layer_rule({ 
    match = { namespace = "quickshell:wallpaperChanger" }, 
    blur = true, 
    ignore_alpha = 0.6, 
    animation = "slide bottom" 
})
-- Games to float
hl.window_rule({ match = { class = "^(Minecraft\\* .*)$" }, float = true })
